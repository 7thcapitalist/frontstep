# Copie para /etc/frontstep-worker.env no mini PC e preencha. Nunca commite o arquivo real.
# Os nomes abaixo sao o esperado; confira contra o /etc/frontstep-worker.env real ao puxar o worker.

# Claude Code headless (token OAuth do plano Max)
CLAUDE_CODE_OAUTH_TOKEN=

# Vercel, conta principal 7thcapitalist
VERCEL_TOKEN=

# Segredo que o n8n manda em Authorization: Bearer ao chamar POST /build
RUNNER_SECRET=

# Base dos webhooks do n8n
N8N_BASE_URL=https://jvcarvalho.app.n8n.cloud/webhook

# So para scripts/export-n8n.mjs (n8n > Settings > n8n API)
N8N_API_KEY=
